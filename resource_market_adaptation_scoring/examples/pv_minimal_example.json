  "components": {
    "pv_demo": {
      "component_type": "pv",
      "source_type": "simulation_assumption",
      "basis": "额定规模为演示设定；可用功率低/高值位于额定容量以内；逆变器响应量级参考第一份资源清单中的公开试验，但本值仍为构造值。",
      "parameters": {
        "rated_power_mw": 1.2,
        "available_power_low_mw": 0.70,
        "available_power_high_mw": 0.85,
        "reserved_up_power_mw": 0.0,
        "response_time_s": 5.0,
        "ramp_rate_mw_per_s": 0.15,
        "tracking_error_pct": 8.0,
        "eligible_green_project": true
      }
    },
    "battery_demo": {
      "component_type": "battery",
      "source_type": "simulation_assumption",
      "basis": "0.5 MW/1.0 MWh构成2小时额定时长，满足第二份文档所录山东独立储能电能量市场持续时间规则量级；SOC和效率为演示设定。",
      "parameters": {
        "rated_power_mw": 0.5,
        "rated_energy_mwh": 1.0,
        "soc": 0.60,
        "soc_min": 0.10,
        "soc_max": 0.90,
        "one_way_efficiency": 0.95,
        "response_time_s": 1.0,
        "ramp_rate_mw_per_s": 0.50,
        "tracking_error_pct": 2.0
      }
    },
    "ev_station_demo": {
      "component_type": "ev_station",
      "source_type": "simulation_assumption",
      "basis": "采用80个在线7 kW交流充电连接构造站级场景；7 kW设备档位来自第一份资源清单所引正式资料，在线数量、当前功率和可移电量均为演示设定。",
      "parameters": {
        "connected_chargers": 80,
        "power_per_charger_mw": 0.007,
        "current_power_per_charger_mw": 0.0035,
        "minimum_power_per_charger_mw": 0.0,
        "flexible_reduction_energy_mwh": 0.20,
        "flexible_increase_energy_mwh": 0.22,
        "response_time_s": 30.0,
        "ramp_rate_mw_per_s": 0.02,
        "tracking_error_pct": 6.0,
        "v2g_enabled": false
      }
    }
