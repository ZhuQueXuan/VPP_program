{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource_submission_schema.json",
  "title": "资源实体提交接口",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "submission_id", "submitted_at", "calculation_purpose", "evidence_status", "entity", "source_records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "submission_id": {"type": "string", "minLength": 1},
    "submitted_at": {"type": "string", "format": "date-time"},
    "calculation_purpose": {"enum": ["standard_profile", "specific_task", "both"]},
    "evidence_status": {"enum": ["verified_entity_data", "public_dataset", "simulation_assumption", "pending_verification"]},
    "source_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_record"}},
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_name", "resource_type", "region", "data_timestamp", "rated_power_mw", "availability_pct", "specific_constraint_pass", "model_parameters", "market_qualification"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "entity_name": {"type": "string", "minLength": 1},
        "resource_type": {"enum": ["分布式光伏", "蓄热锅炉", "冷水机组", "冷库", "辅助泵类", "高压电机泵", "空调", "充电桩（充电站）", "水泥（球磨机）", "中频电炉", "电窑炉", "储能", "算力", "搅拌机", "烘干机（热泵）", "压机（液压/油压/水压）"]},
        "aggregation_id": {"type": ["string", "null"]},
        "region": {"type": "string", "minLength": 1},
        "data_timestamp": {"type": "string", "format": "date-time"},
        "rated_power_mw": {"type": "number", "exclusiveMinimum": 0},
        "availability_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "response_time_s": {"type": ["number", "null"], "minimum": 0},
        "ramp_rate_mw_per_min": {"type": ["number", "null"], "minimum": 0},
        "tracking_error_pct": {"type": ["number", "null"], "minimum": 0},
        "specific_constraint_pass": {"type": ["boolean", "null"]},
        "model_parameters": {"type": "object", "minProperties": 1, "additionalProperties": true},
        "market_qualification": {"$ref": "#/$defs/qualification"}
      }
    }
  },
  "$defs": {
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registered": {"type": ["boolean", "null"]},
        "metering": {"type": ["boolean", "null"]},
        "communication": {"type": ["boolean", "null"]},
        "direct_control": {"type": ["boolean", "null"]},
        "performance_test": {"type": ["boolean", "null"]},
        "green_project_eligible": {"type": ["boolean", "null"]},
        "traceable": {"type": ["boolean", "null"]},
        "consumer_relation": {"type": ["boolean", "null"]},
        "green_contract": {"type": ["boolean", "null"]},
        "consumer_metered": {"type": ["boolean", "null"]}
      }
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "description"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["entity_measurement", "test_report", "official_rule", "public_dataset", "peer_reviewed_paper", "simulation_assumption", "manual_entry"]},
        "description": {"type": "string", "minLength": 1},
        "url_or_path": {"type": ["string", "null"]},
        "verified_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
