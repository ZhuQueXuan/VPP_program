{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scoring_result_schema.json",
  "title": "资源市场适配结果接口",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "calculated_at", "engine_version", "submission_id", "entity_id", "resource_type", "task_id", "calculation_mode", "market_output", "region", "capability", "market_status", "admission_status", "specific_constraint_status", "metric_ratios", "bottleneck_metric", "feasibility", "diagnostic_scenario_fit_index", "benchmark_fit_index", "formal_scenario_fit_index", "evidence_status", "data_completeness_pct", "missing_fields", "evaluated_rule_ids", "failed_rule_ids", "explanation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "result_id": {"type": "string", "minLength": 1},
    "calculated_at": {"type": "string", "format": "date-time"},
    "engine_version": {"type": "string", "minLength": 1},
    "submission_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "resource_type": {"type": "string", "minLength": 1},
    "aggregation_id": {"type": ["string", "null"]},
    "task_id": {"type": "string", "minLength": 1},
    "calculation_mode": {"enum": ["standard_benchmark", "specific_task"]},
    "market_output": {"enum": ["spot_fit", "frequency_fit", "reserve_readiness", "ramping_fit", "green_supply_fit", "green_consumption_fit"]},
    "region": {"type": "string", "minLength": 1},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_up_power_mw", "available_down_power_mw", "available_up_energy_mwh", "available_down_energy_mwh", "duration_h", "response_time_s", "ramp_rate_mw_per_min", "tracking_error_pct"],
      "properties": {
        "available_up_power_mw": {"type": ["number", "null"], "minimum": 0},
        "available_down_power_mw": {"type": ["number", "null"], "minimum": 0},
        "available_up_energy_mwh": {"type": ["number", "null"], "minimum": 0},
        "available_down_energy_mwh": {"type": ["number", "null"], "minimum": 0},
        "duration_h": {"type": ["number", "null"], "minimum": 0},
        "response_time_s": {"type": ["number", "null"], "minimum": 0},
        "ramp_rate_mw_per_min": {"type": ["number", "null"], "minimum": 0},
        "tracking_error_pct": {"type": ["number", "null"], "minimum": 0},
        "eligible_green_energy_mwh": {"type": ["number", "null"], "minimum": 0},
        "shiftable_load_power_mw": {"type": ["number", "null"], "minimum": 0},
        "shiftable_load_energy_mwh": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "market_status": {"enum": ["operational", "planned", "not_open", "unknown"]},
    "admission_status": {"enum": ["pass", "fail", "pending_evidence", "not_applicable"]},
    "specific_constraint_status": {"enum": ["pass", "fail", "pending_evidence"]},
    "metric_ratios": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
    "bottleneck_metric": {"type": ["string", "null"]},
    "feasibility": {"enum": ["feasible", "not_feasible", "not_computable", "not_applicable"]},
    "diagnostic_scenario_fit_index": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100}, {"enum": ["not_computable", "not_applicable"]}]},
    "benchmark_fit_index": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100}, {"enum": ["not_computable", "not_applicable"]}]},
    "formal_scenario_fit_index": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100}, {"enum": ["not_computable", "not_applicable"]}]},
    "evidence_status": {"enum": ["verified_entity_data", "verified_market_task", "public_dataset", "simulation_assumption", "pending_verification", "mixed_evidence"]},
    "data_completeness_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "missing_fields": {"type": "array", "items": {"type": "string"}},
    "evaluated_rule_ids": {"type": "array", "items": {"type": "string"}},
    "failed_rule_ids": {"type": "array", "items": {"type": "string"}},
    "explanation": {"type": "string"}
  }
}
